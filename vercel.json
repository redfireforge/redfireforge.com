{
  "rewrites": [
    { "source": "/dl/:tag/:file", "destination": "/api/dl?tag=:tag&file=:file" },
    {
      "source": "/((?!api/|.*\\.(?:svg|png|ico|jpg|jpeg|gif|webp|xml|txt|json|js|css|map|woff2?)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
